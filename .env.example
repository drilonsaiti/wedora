# Upload limits
MAX_FILE_SIZE_MB=10

CRON_SECRET=your-secret-key-for-cron-job
ZIP_WORKER_SECRET=your-long-random-secret
UPLOAD_RATE_LIMIT_SECRET=YOUR_LONG_RANDOM_SECRET
LOGIN_RATE_LIMIT_SECRET=YOUR_LONG_RANDOM_SECRET